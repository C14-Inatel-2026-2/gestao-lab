# true  -> usa a API mock em memoria (funciona sem backend)
# false -> consome o backend Spring Boot de verdade
VITE_USE_MOCK=true

# URL base da API real (usada quando VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8080/api

# Alvo do proxy do vite dev server para /api
VITE_PROXY_TARGET=http://localhost:8080
