# Variaveis lidas pelo compose.deploy.yaml. Copie para .env na raiz e preencha.
# O .env esta no .gitignore: nunca versione credenciais.

# Administrador inicial. Opcional, e criado apenas na primeira subida.
# Se ja existir qualquer ADMIN no banco, nada e criado ou alterado.
# Nome e e-mail seguem as validacoes do cadastro; a senha precisa de 8 a 72
# caracteres, com ao menos uma letra maiuscula e um digito. Nao existe senha
# padrao. A senha e gravada com BCrypt.
# Depois de criar a conta, volte INITIAL_ADMIN_ENABLED para false e remova as
# credenciais daqui.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
